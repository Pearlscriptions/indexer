NODE_ENV=production
PORT=3000
HOST=127.0.0.1

PRL20_CHAIN=pearl-mainnet
# Local checkout default. If you run the app inside a container mounted at /app,
# use PRL20_RELEASE_MANIFEST=/app/release-manifest.example.json instead.
PRL20_RELEASE_MANIFEST=./release-manifest.example.json

POSTGRES_DB=pearlscriptions_indexer
POSTGRES_USER=pearlscriptions
POSTGRES_PASSWORD=CHANGE_ME

# Node requirement (MoE hard fork): pearld >= v1.1.0.
# The MoE hard fork activated on 2026-06-12. Point PEARL_RPC_URL at a pearld
# node running >= v1.1.0 so the indexer follows the post-fork canonical chain.
# The indexer detects a stale or non-canonical node chain on its own and exposes
# it as ADVISORY status only (it never blocks sync or changes PRL-20 state):
#   - canonicalCheckpoints in PRL20_RELEASE_MANIFEST pin known post-fork block
#     hashes; a mismatch surfaces as checkpoint.status="mismatch".
#   - the node version is read from getnetworkinfo (subversion "pearld:x.y.z");
#     a node below v1.1.0 surfaces pearlNodeVersion.meetsMinimum=false.
# These signals appear on /health (ok stays true, with a "warning"),
# /indexer/status, and /indexer/digest. No extra env var is required.
PEARL_RPC_URL=http://127.0.0.1:44107
PEARL_RPC_USER=CHANGE_ME
PEARL_RPC_PASSWORD=CHANGE_ME
PEARL_RPC_RETRIES=3
PEARL_RPC_RETRY_DELAY_MS=750

PRL20_INDEXER_STORAGE_BACKEND=postgres
# Keep this in sync with POSTGRES_USER and POSTGRES_PASSWORD for local Docker.
PRL20_DATABASE_URL=postgres://pearlscriptions:CHANGE_ME@127.0.0.1:5432/pearlscriptions_indexer
PRL20_INDEXER_MANIFEST_NAME=mainnet
PRL20_INDEXER_START_HEIGHT=0
PRL20_INDEXER_BATCH_SIZE=100
PRL20_INDEXER_BACKGROUND_SYNC_MS=30000
# v1.3.0: default is full read-model publish. For production Postgres workers,
# opt in after the first full publish has completed:
# PRL20_INDEXER_READ_MODEL_MODE=incremental
# Optional protocol/read-model parity safety check cadence. 0 disables it.
PRL20_INDEXER_PARITY_CHECK_EVERY_N_BLOCKS=0

PUBLIC_API_READ_ONLY=1

# Optional v1.1 operator registry compatibility metadata.
# Leave empty unless you want /operator and /.well-known/pearlscriptions-indexer.json
# to advertise public operator details. These fields are read-only and never
# register with the official registry by themselves.
# PRL20_OPERATOR_PUBLIC_URL should be a public HTTPS origin for registry checks.
# Local HTTP URLs are only for local self-checks.
# Values with spaces can be quoted, for example:
# PRL20_OPERATOR_NAME="Pearl Operator"
PRL20_OPERATOR_NAME=
PRL20_OPERATOR_PUBLIC_URL=
PRL20_OPERATOR_REWARD_ADDRESS=
PRL20_OPERATOR_REGION=
PRL20_OPERATOR_CONTACT_URL=
PRL20_OPERATOR_REGISTRY_CHALLENGE=
